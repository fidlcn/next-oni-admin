# ===== 环境变量模板 =====
# 复制为 .env.production 并修改对应值
# cp deploy/.env.example apps/server/.env.production

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=YOUR_DB_USERNAME
DB_PASSWORD=YOUR_DB_PASSWORD
DB_DATABASE=next_oni_admin

# 应用配置
APP_PORT=3000
APP_PREFIX=/v1

# JWT 配置
# 生产环境必须使用强随机密钥！生成方式：openssl rand -base64 64
JWT_SECRET=GENERATE_A_RANDOM_SECRET_HERE
JWT_ACCESS_EXPIRY=2h
JWT_REFRESH_EXPIRY=7d

# CORS —— 生产环境允许主站和管理后台域名（逗号分隔）
CORS_ORIGIN=https://www.example.com,https://admin.example.com

# 站点配置（后端不直接使用，供部署脚本参考）
SITE_URL=https://www.example.com
ADMIN_URL=https://admin.example.com
SITE_PORT=3001
