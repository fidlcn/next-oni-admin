# ===== 环境变量模板 =====
# 复制为 .env.production 并修改对应值
# cp deploy/.env.example apps/server/.env.production

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=YOUR_DB_USERNAME
DB_PASSWORD=YOUR_DB_PASSWORD
DB_DATABASE=next_oni_admin

# 应用配置
APP_PORT=3000
APP_PREFIX=/v1

# JWT 配置
# 生产环境必须使用强随机密钥！生成方式：openssl rand -base64 64
JWT_SECRET=GENERATE_A_RANDOM_SECRET_HERE
JWT_ACCESS_EXPIRY=2h
JWT_REFRESH_EXPIRY=7d

# CORS —— 生产环境允许主站和管理后台域名（逗号分隔）
CORS_ORIGIN=https://www.example.com,https://admin.example.com

# 站点配置（后端不直接使用，供部署脚本参考）
SITE_URL=https://www.example.com
ADMIN_URL=https://admin.example.com
SITE_PORT=3001

# CSRF 密钥（csrf-csrf 双提交 Cookie 用）—— openssl rand -base64 64
CSRF_SECRET=GENERATE_A_RANDOM_SECRET_HERE

# ===== 托管页生成（pagegen）=====

# GLM API Key —— 只存在于此文件（权限 600），不进仓库/镜像/日志
# 换 key：改这一行后重启服务（pm2 restart all / systemctl restart）
GLM_API_KEY=GENERATE_GLM_API_KEY_HERE

# OpenAI 兼容端点与模型（大陆服务器用 open.bigmodel.cn；glm-5.3-flash 成本约为旗舰 1/10）
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.3
GLM_MAX_TOKENS=16384

# 费用估算单价（元 / 百万 tokens，与智谱定价页保持同步；仅用于管理端统计展示）
GLM_PRICE_IN=8
GLM_PRICE_OUT=28

# 访问口令（≥16 位随机串：openssl rand -hex 16）；泄露后改这里重启即换
PAGEGEN_ACCESS_CODE=GENERATE_ACCESS_CODE_HERE

# 频控：每 IP 每天 / 全局每天提交上限（全局上限与 IP 无关，是费用兜底）
PAGEGEN_DAILY_IP_LIMIT=10
PAGEGEN_DAILY_GLOBAL_LIMIT=200

# 生产必配主站绝对地址（管理端「查看」跨域跳转依赖它）
PAGEGEN_PUBLIC_BASE_URL=https://www.example.com/p

# 联网搜索（默认关闭；系统提示词同样禁联网。将来放开置 true 即可，不改代码）
PAGEGEN_WEB_SEARCH=false

# 追加敏感词（逗号分隔，与内置硬词表合并）
PAGEGEN_SENSITIVE_EXTRA=
