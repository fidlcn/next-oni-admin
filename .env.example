# ===== 本地 Docker 部署环境变量模板 =====
# 用法：cp .env.example .env，把下面的值换成自己的随机值
# （docker compose 会自动读取项目根目录的 .env 做变量插值）

# MySQL root 密码（仅容器网络内可达）
MYSQL_ROOT_PASSWORD=CHANGE_ME

# 应用数据库密码（app 与 mysql 两个服务共用）
DB_PASSWORD=CHANGE_ME

# JWT 签名密钥 —— openssl rand -base64 48
JWT_SECRET=CHANGE_ME

# CSRF 双提交 Cookie 签名密钥 —— openssl rand -base64 32
CSRF_SECRET=CHANGE_ME

# 托管页生成提交口令 —— openssl rand -hex 16（在主站 /gen 表单输入）
PAGEGEN_ACCESS_CODE=CHANGE_ME

# GLM API Key（智谱开放平台；留空则生成功能不可用）
GLM_API_KEY=
