# 本地开发环境配置模板 —— 复制为 .env.development 并按需修改
# 所有 .env* 文件均不入库（.gitignore），密钥只存在于本机/服务器

# 数据库 —— 连接本地 MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_dev_password
DB_DATABASE=next_oni_admin

# 应用
APP_PORT=3000
APP_PREFIX=/v1

# JWT —— 开发环境使用固定密钥，生产环境必须更换
JWT_SECRET=dev-secret-key-change-in-production
JWT_ACCESS_EXPIRY=2h
JWT_REFRESH_EXPIRY=7d

# CORS —— 开发环境允许前端 dev server 端口
CORS_ORIGIN=http://localhost:5173

# ===== 托管页生成（pagegen）=====

# GLM API Key（https://open.bigmodel.cn 控制台获取；建议独立子账号并设额度上限）
GLM_API_KEY=

# OpenAI 兼容端点与模型（大陆服务器用 open.bigmodel.cn；glm-5.3-flash 成本约为旗舰的 1/10）
GLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
GLM_MODEL=glm-5.3
GLM_MAX_TOKENS=16384

# 费用估算单价（元 / 百万 tokens，按智谱定价页同步维护；仅用于管理端统计展示）
GLM_PRICE_IN=8
GLM_PRICE_OUT=28

# 访问口令 —— 建议 16 位以上随机串：openssl rand -hex 16
PAGEGEN_ACCESS_CODE=

# 频控：每 IP 每天 / 全局每天提交上限（全局上限与 IP 无关，是费用兜底）
PAGEGEN_DAILY_IP_LIMIT=10
PAGEGEN_DAILY_GLOBAL_LIMIT=200

# 生成页访问基址：留空默认同源 /p；
# 生产建议配主站绝对地址（管理端跨域跳转需要）：https://www.example.com/p
PAGEGEN_PUBLIC_BASE_URL=

# 联网搜索（默认关闭；系统提示词同样禁联网。放开时置 true 即可，不改代码）
PAGEGEN_WEB_SEARCH=false

# 追加敏感词（逗号分隔，与内置硬词表合并）
PAGEGEN_SENSITIVE_EXTRA=
